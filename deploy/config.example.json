{
  "host": "127.0.0.1",
  "port": 8765,
  "dataDir": "/var/lib/omp-video-bridge",
  "tokenFile": "/etc/omp-video-bridge/token",
  "omp": {
    "bin": "/usr/local/bin/omp",
    "skillDirs": []
  },
  "env": {
    "HYPERFRAMES_BROWSER_PATH": "/opt/hyperframes/chrome/chrome-headless-shell",
    "HYPERFRAMES_PYTHON": "/opt/hyperframes-tts/venv/bin/python"
  },
  "webhook": {
    "url": "http://127.0.0.1:8644/webhooks/omp-video",
    "secret": "REPLACE-WITH-A-UNIQUE-RANDOM-SECRET"
  },
  "containerMount": {
    "host": "/var/lib/omp-video-bridge",
    "container": "/videos-v2"
  }
}

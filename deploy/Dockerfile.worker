# syntax=docker/dockerfile:1.7
ARG WORKER_RUNTIME_IMAGE=omp-video-runtime:18.4.4-hf0.8.82-cpu
FROM ${WORKER_RUNTIME_IMAGE} AS bridge-deps
USER root
RUN install -d -o 1001 -g 1001 /build/bridge
USER 1001:1001
WORKDIR /build/bridge
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/home/worker/.npm,uid=1001,gid=1001 \
    npm ci --ignore-scripts --no-audit --fund=false --omit=dev --cache /home/worker/.npm

FROM ${WORKER_RUNTIME_IMAGE}
# Preserve the checksum-pinned skills snapshot even when a job scaffolds a project.
ENV HYPERFRAMES_SKIP_SKILLS=1
COPY --from=bridge-deps --chown=1001:1001 /build/bridge/node_modules /opt/bridge/node_modules
COPY --chown=1001:1001 deploy/prepare-assets.py deploy/prepare-assets.sh deploy/runtime-lock.json \
    deploy/worker-entrypoint.mjs deploy/init-state.mjs deploy/worker-config.example.json /opt/bridge/deploy/
# Application source is last: ordinary edits reuse all dependency layers.
COPY --chown=1001:1001 package.json package-lock.json tsconfig.json LICENSE NOTICE /opt/bridge/
COPY --chown=1001:1001 src /opt/bridge/src
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=12 \
  CMD curl -fsS http://127.0.0.1:8765/v1/health >/dev/null || exit 1
ENTRYPOINT ["node", "--disable-warning=ExperimentalWarning", "/opt/bridge/deploy/worker-entrypoint.mjs"]
LABEL org.opencontainers.image.title="omp-video-worker" \
      org.opencontainers.image.description="CPU video worker with external checksum-pinned models and Chrome" \
      org.opencontainers.image.version="2.0.2"

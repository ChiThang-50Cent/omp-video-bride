; Rendered by deploy/install.sh. Do not copy this template directly into /etc/systemd/system.
[Unit]
Description=omp video bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKDIR@
Environment=@HOME_ENV@
Environment=@USER_ENV@
Environment=@PATH_ENV@
Environment=@CONFIG_ENV@
ExecStart=@NODE@ --disable-warning=ExperimentalWarning src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
